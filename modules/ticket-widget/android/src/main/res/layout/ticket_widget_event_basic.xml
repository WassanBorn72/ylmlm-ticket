<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="4dp" android:paddingRight="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
  <LinearLayout android:id="@+id/ticket_row" android:layout_width="match_parent" android:layout_height="72sp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="4dp" android:layout_marginBottom="0dp" android:background="@drawable/ticket_widget_row" android:layout_weight="0" android:layout_marginTop="0dp" android:layout_marginLeft="0dp" android:layout_marginRight="0dp">
    <LinearLayout android:id="@+id/ticket_date" android:layout_width="58dp" android:layout_height="wrap_content" android:minHeight="42dp" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/ticket_widget_date">
      <TextView android:id="@+id/ticket_month" android:maxLines="1" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11月" android:textColor="#287B59" android:textSize="10sp" android:includeFontPadding="false" android:textStyle="normal" />
      <TextView android:id="@+id/ticket_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#1D5139" android:textSize="20sp" android:textStyle="normal" android:includeFontPadding="false" />
      <TextView android:id="@+id/ticket_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日" android:textColor="#287B59" android:textSize="10sp" android:includeFontPadding="false" android:textStyle="normal" />
      <LinearLayout android:id="@+id/ticket_badges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="1dp" android:visibility="gone">
        <TextView android:id="@+id/ticket_site" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textStyle="normal" android:paddingLeft="3dp" android:paddingRight="3dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="6dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ticket_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="公演名" android:textColor="#17212B" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:lineSpacingExtra="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/ticket_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:textSize="11sp" android:textColor="#52616D" android:maxLines="1" android:includeFontPadding="false" android:textStyle="normal" />
      </LinearLayout>
      <TextView android:id="@+id/ticket_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="0dp" android:textSize="11sp" android:textColor="#203047" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="normal" android:layout_marginTop="2dp" />
      <LinearLayout android:id="@+id/ticket_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/ticket_meta" android:layout_width="0dp" android:layout_height="wrap_content" android:text="会場名" android:textColor="#287B59" android:textSize="12sp" android:layout_marginTop="0dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" android:textStyle="normal" android:drawableLeft="@drawable/ticket_widget_map_pin" android:drawablePadding="4dp" android:gravity="center_vertical" android:minHeight="18dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/ticket_timing_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:paddingLeft="5dp" android:paddingRight="5dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:layout_marginTop="2dp" android:background="@drawable/ticket_widget_timings" android:gravity="center_vertical">
        <TextView android:id="@+id/ticket_performance" android:textStyle="normal" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#24539B" android:textSize="11sp" android:layout_marginTop="0dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_weight="1" />
        <TextView android:id="@+id/ticket_meet" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" android:textColor="#24539B" android:textSize="11sp" android:layout_marginTop="0dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textStyle="normal" android:layout_weight="1" android:layout_marginLeft="4dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>