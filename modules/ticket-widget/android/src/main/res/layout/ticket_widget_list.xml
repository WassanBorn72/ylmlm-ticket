<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ticket_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:clipToOutline="true" android:background="@drawable/ticket_widget_background">
  <LinearLayout android:id="@+id/ticket_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:background="#E4EEE8">
    <TextView android:id="@+id/ticket_widget_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="モ！のチケット帳" android:textColor="#1D5139" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/ticket_widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="直近" android:textColor="#416452" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="非公式" android:layout_marginLeft="6dp" android:padding="2dp" android:textColor="#52616D" android:textSize="9sp" android:includeFontPadding="false" android:background="@drawable/ticket_widget_date" />
  </LinearLayout>
  <FrameLayout android:id="@+id/ticket_widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ListView android:id="@+id/ticket_widget_events" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="0dp" android:padding="0dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:scrollbarSize="2dp" android:cacheColorHint="@android:color/transparent" android:overScrollMode="never" />
    <TextView android:id="@+id/ticket_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top" android:padding="10dp" android:text="アプリで公演情報を更新" android:textColor="#52695D" android:textSize="12sp" android:visibility="gone" />
  </FrameLayout>
  <LinearLayout android:id="@+id/ticket_widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="22dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:paddingVertical="2dp" android:orientation="horizontal" android:background="#E4EEE8">
    <TextView android:id="@+id/ticket_widget_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="アプリを開いて更新" android:textColor="#52616D" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/ticket_widget_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="一覧 ›" android:textColor="#245C42" android:textSize="11sp" android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>
