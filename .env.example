# 実機から到達できるサーバーの HTTPS URL（末尾スラッシュ不要）
# 未設定時は、購入リンクのないサンプル画面になります。
EXPO_PUBLIC_API_URL=
# Expo / EAS プロジェクト UUID。実機通知の利用時に設定します。
EXPO_PUBLIC_EAS_PROJECT_ID=
# サーバーの設定はシェルの環境変数で指定してください。
# PORT=3001
# POLL_INTERVAL_MS=900000
# SOURCE_CONFIG=server/sources.json
# DATA_DIR=server/data
# ALLOWED_ORIGINS=http://localhost:8081
