{
  "expo": {
    "name": "モ！のチケット帳（非公式）",
    "slug": "ylmlm-unofficial-ticket",
    "version": "0.9.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ylmlm-unofficial-ticket",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.ylmlm.unofficial.ticket",
      "buildNumber": "29",
      "infoPlist": {
        "NSCalendarsUsageDescription": "選択した公演をカレンダーに追加するために使用します。"
      }
    },
    "android": {
      "package": "jp.ylmlm.unofficial.ticket",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 29,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "name": "モ！のチケット帳（非公式）",
      "bundler": "metro",
      "favicon": "./assets/launcher-icon.png"
    },
    "icon": "./assets/launcher-icon.png",
    "plugins": [
      "./plugins/with-local-notifications-only",
      [
        "expo-calendar",
        {
          "calendarPermission": "選択した公演をカレンダーに追加するために使用します。",
          "remindersPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "ticket-sales"
        }
      ]
    ]
  }
}
