{
  "name": "ylmlm-ticket",
  "version": "0.6.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:web": "node scripts/smoke-web.mjs",
    "test:live": "node --use-env-proxy scripts/check-live.mjs",
    "build:web": "expo export --platform web",
    "build:android": "expo prebuild --platform android --no-install && node scripts/configure-android-signing.mjs && cd android && ./gradlew assembleRelease --no-daemon --max-workers 2 -PreactNativeArchitectures=arm64-v8a,armeabi-v7a '-Dorg.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=1g'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "cheerio": "1.2.0",
    "expo": "~55.0.31",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.2"
  }
}
